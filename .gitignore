# Build output
target/
*.class
*.jar

# Local configuration - contains the database password
config/local.properties

# Uploaded files created at runtime
uploads/*
# The seed gallery images are the only uploads committed: they are what the
# demo's Browse Listings and Review Queue screens point at.
!uploads/images/
uploads/images/*
!uploads/images/seed/
proofs/

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# JVM crash logs
hs_err_pid*.log
replay_pid*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Brand source files. The derived assets the application loads are committed
# under src/main/resources/images.
Artifacts/
