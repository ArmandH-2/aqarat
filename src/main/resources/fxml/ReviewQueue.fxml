<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.ReviewQueueController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="30" right="40" bottom="34" left="40"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="18">
            <!-- Header -->
            <VBox spacing="5">
                <Label text="REVIEW" styleClass="eyebrow"/>
                <Label text="Submissions waiting" styleClass="display-title"/>
                <Label text="An owner cannot publish their own property. Claim one to see its valuation, its comparables and the flag on its asking price." styleClass="hint" wrapText="true" maxWidth="760"/>
            </VBox>

            <!-- Segmented Tab Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="unassignedTabButton" text="Unclaimed" styleClass="tab-pill-button, active"
                        onAction="#handleUnassignedTab"/>
                <Button fx:id="myQueueTabButton" text="Claimed by me" styleClass="tab-pill-button"
                        onAction="#handleMyQueueTab"/>
            </HBox>

            <!-- Submissions List -->
            <ListView fx:id="propertyList" minHeight="480"/>

            <!-- Pagination -->
            <HBox spacing="16" alignment="CENTER">
                <Button fx:id="previousButton" text="← Previous" styleClass="button, button-secondary"
                        onAction="#handlePrevious"/>
                <Button fx:id="nextButton" text="Next →" styleClass="button, button-secondary"
                        onAction="#handleNext"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
