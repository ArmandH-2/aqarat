<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane styleClass="panel" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.ReviewQueueController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="0" right="6" bottom="28" left="0"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="18">
            <!-- Header -->
            <VBox spacing="2">
                <Label text="Property Review Pipeline" styleClass="page-title"/>
                <Label text="Evaluate property submissions, run valuation estimates, and publish approved listings" styleClass="hint"/>
            </VBox>

            <!-- Segmented Tab Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="unassignedTabButton" text="Unassigned Pipeline" styleClass="tab-pill-button, active"
                        onAction="#handleUnassignedTab"/>
                <Button fx:id="myQueueTabButton" text="My Review Queue" styleClass="tab-pill-button"
                        onAction="#handleMyQueueTab"/>
            </HBox>

            <!-- Submissions List -->
            <ListView fx:id="propertyList" minHeight="480"/>

            <!-- Pagination -->
            <HBox spacing="16" alignment="CENTER">
                <Button fx:id="previousButton" text="← Previous" styleClass="button, button-secondary"
                        onAction="#handlePrevious"/>
                <Button fx:id="nextButton" text="Next →" styleClass="button, button-secondary"
                        onAction="#handleNext"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
