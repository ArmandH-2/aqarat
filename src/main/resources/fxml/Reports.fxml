<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.ReportsController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="30" right="40" bottom="34" left="40"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="18">
            <!-- Header -->
            <VBox spacing="5">
                <Label text="ADMINISTRATION" styleClass="eyebrow"/>
                <Label text="Revenue, arrears and accuracy" styleClass="display-title"/>
                <Label text="Commission booked by month, what is overdue, and how close the estimator has been to the prices that were actually agreed." styleClass="hint" wrapText="true" maxWidth="760"/>
            </VBox>

            <!-- Segmented Tab Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="revenueTabButton" text="Revenue" styleClass="tab-pill-button, active"
                        onAction="#handleRevenueTab"/>
                <Button fx:id="overdueTabButton" text="Arrears" styleClass="tab-pill-button"
                        onAction="#handleOverdueTab"/>
                <Button fx:id="marketTabButton" text="Estimator accuracy" styleClass="tab-pill-button"
                        onAction="#handleMarketTab"/>
            </HBox>

            <!-- Revenue Report Tab -->
            <VBox fx:id="revenueBox" spacing="14">
                <VBox styleClass="card" spacing="10">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="From" styleClass="label-soft"/>
                            <DatePicker fx:id="revenueFromPicker" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="To" styleClass="label-soft"/>
                            <DatePicker fx:id="revenueToPicker" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="4" alignment="BOTTOM_LEFT">
                            <Label text="" styleClass="label-soft"/>
                            <Button text="Run" styleClass="button, button-primary" prefHeight="36" onAction="#handleRunRevenue"/>
                        </VBox>
                    </HBox>
                </VBox>

                <TableView fx:id="revenueTable" minHeight="450"/>
            </VBox>

            <!-- Overdue Collections Tab -->
            <VBox fx:id="overdueBox" spacing="14" managed="false" visible="false">
                <TableView fx:id="overdueTable" minHeight="500"/>
            </VBox>

            <!-- Market Time & Valuation Accuracy Tab -->
            <VBox fx:id="marketBox" spacing="14" managed="false" visible="false">
                <TableView fx:id="marketTable" minHeight="500"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
