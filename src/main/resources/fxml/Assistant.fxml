<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.syntropyhq.aqarat.controller.AssistantController"
      spacing="16" VBox.vgrow="ALWAYS">
    <padding>
        <Insets top="0" right="6" bottom="16" left="0"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Search Assistant" styleClass="page-title"/>
            <Label text="Describe what you are looking for and find matching listings" styleClass="hint"/>
        </VBox>
        <Button fx:id="startOverButton" text="Start over" styleClass="button, button-ghost"
                onAction="#handleStartOver"/>
    </HBox>

    <!-- Transcript ScrollPane -->
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                VBox.vgrow="ALWAYS" styleClass="scroll-pane">
        <VBox fx:id="transcriptBox" spacing="16">
            <padding>
                <Insets top="8" right="12" bottom="8" left="4"/>
            </padding>
        </VBox>
    </ScrollPane>

    <!-- Input Bar pinned to bottom -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="inputField" promptText="Ask anything (e.g. 3 bedroom apartment in Beirut under 300k)..."
                   HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#handleSend"/>
        <Button fx:id="sendButton" text="Send" styleClass="button, button-primary"
                onAction="#handleSend"/>
    </HBox>
</VBox>
