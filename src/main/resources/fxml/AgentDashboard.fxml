<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane styleClass="panel" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.AgentDashboardController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="24">
        <padding>
            <Insets top="0" right="6" bottom="28" left="0"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="24">
            <!-- Header -->
            <VBox spacing="2">
                <Label text="Agent Operations Dashboard" styleClass="page-title"/>
                <Label text="Overview of submission pipeline, active inventory, weekly appointments, and agency collections" styleClass="hint"/>
            </VBox>

            <!-- Top Row Stat Tiles -->
            <HBox spacing="16">
                <VBox fx:id="queueCard" styleClass="stat-tile" spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="queueCountLabel" styleClass="metric-value" style="-fx-text-fill: -c-warn;" text="0"/>
                    </HBox>
                    <Label text="Waiting in your review queue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                    <Label text="Click to review pending submissions →" styleClass="hint"/>
                </VBox>

                <VBox fx:id="unassignedCard" styleClass="stat-tile" spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="unassignedCountLabel" styleClass="metric-value" style="-fx-text-fill: -c-bad;" text="0"/>
                    </HBox>
                    <Label text="Unassigned submissions" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                    <Label text="Awaiting agent claim" styleClass="hint"/>
                </VBox>

                <VBox fx:id="activeListingsCard" styleClass="stat-tile" spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="activeListingsCountLabel" styleClass="metric-value" style="-fx-text-fill: -c-good;" text="0"/>
                    </HBox>
                    <Label text="Your active published listings" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                    <Label text="Live on public discovery" styleClass="hint"/>
                </VBox>
            </HBox>

            <!-- Second Row Stat Tiles -->
            <HBox spacing="16">
                <VBox fx:id="weekViewingsCard" styleClass="stat-tile" spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="weekViewingsCountLabel" styleClass="metric-value" style="-fx-text-fill: -c-info;" text="0"/>
                    </HBox>
                    <Label text="Scheduled viewings this week" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                    <Label text="Next 7 days appointments" styleClass="hint"/>
                </VBox>

                <VBox fx:id="overdueCard" styleClass="stat-tile" spacing="8" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="overdueCountLabel" styleClass="metric-value" style="-fx-text-fill: -c-bad;" text="0"/>
                    </HBox>
                    <Label fx:id="overdueCaptionLabel" text="Payments overdue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                    <Label text="Requires collection follow-up" styleClass="hint"/>
                </VBox>
            </HBox>

            <!-- Quick Action Command Bar -->
            <VBox styleClass="card" spacing="14">
                <Label text="Quick Navigation" styleClass="section-title"/>
                <HBox spacing="12">
                    <Button text="📋 Review Queue" styleClass="button, button-primary" onAction="#handleGoReviewQueue"/>
                    <Button text="🏠 All Listings" styleClass="button, button-secondary" onAction="#handleGoListings"/>
                    <Button text="📅 Viewings Schedule" styleClass="button, button-secondary" onAction="#handleGoViewings"/>
                    <Button text="💳 Payments Ledger" styleClass="button, button-secondary" onAction="#handleGoPayments"/>
                    <Button text="📄 Contracts Hub" styleClass="button, button-secondary" onAction="#handleGoContracts"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
