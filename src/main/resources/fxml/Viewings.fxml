<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane styleClass="panel" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.ViewingsController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="0" right="6" bottom="28" left="0"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="18">
            <!-- Header -->
            <VBox spacing="2">
                <Label text="Property Viewing Appointments" styleClass="page-title"/>
                <Label text="Manage client viewing requests, confirm upcoming schedules, and log appointment outcomes" styleClass="hint"/>
            </VBox>

            <!-- Segmented Tab Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="requestsTabButton" text="Incoming Requests" styleClass="tab-pill-button, active"
                        onAction="#handleRequestsTab"/>
                <Button fx:id="myViewingsTabButton" text="My Confirmed Viewings" styleClass="tab-pill-button"
                        onAction="#handleMyViewingsTab"/>
            </HBox>

            <!-- Viewings List -->
            <ListView fx:id="viewingList" minHeight="500"/>
        </VBox>
    </VBox>
</ScrollPane>
