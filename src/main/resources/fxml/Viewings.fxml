<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.ViewingsController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="30" right="40" bottom="34" left="40"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="18">
            <!-- Header -->
            <VBox spacing="5">
                <Label text="APPOINTMENTS" styleClass="eyebrow"/>
                <Label text="Viewings" styleClass="display-title"/>
                <Label text="A client asks, an agent confirms. One agent cannot hold two confirmed viewings at the same hour, enforced by the database, not by this screen." styleClass="hint" wrapText="true" maxWidth="760"/>
            </VBox>

            <!-- Segmented Tab Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="requestsTabButton" text="Requests" styleClass="tab-pill-button, active"
                        onAction="#handleRequestsTab"/>
                <Button fx:id="myViewingsTabButton" text="Confirmed" styleClass="tab-pill-button"
                        onAction="#handleMyViewingsTab"/>
            </HBox>

            <!-- Viewings List -->
            <ListView fx:id="viewingList" minHeight="500"/>
        </VBox>
    </VBox>
</ScrollPane>
