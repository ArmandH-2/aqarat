<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.ContractsController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="30" right="40" bottom="34" left="40"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="18">
            <!-- Header -->
            <VBox spacing="5">
                <Label text="AGREEMENTS" styleClass="eyebrow"/>
                <Label text="Contracts" styleClass="display-title"/>
                <Label text="Activating one moves the property off the market, generates its payment schedule and books the commission. All of it, or none of it — never half." styleClass="hint" wrapText="true" maxWidth="760"/>
            </VBox>

            <!-- Segmented Tab Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="contractsTabButton" text="All contracts" styleClass="tab-pill-button, active"
                        onAction="#handleContractsTab"/>
                <Button fx:id="draftTabButton" text="Draft a contract" styleClass="tab-pill-button"
                        onAction="#handleDraftTab"/>
            </HBox>

            <!-- Contracts Tab Content -->
            <VBox fx:id="contractsBox" spacing="14">
                <ListView fx:id="contractList" styleClass="page-list"/>
            </VBox>

            <!-- Draft Contract Form Tab Content -->
            <ScrollPane fx:id="draftBox" fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-background: transparent;"
                        managed="false" visible="false">
                <VBox spacing="20">
                    <!-- 1. Parties & Property Identity -->
                    <VBox styleClass="card" spacing="14">
                        <Label text="1. Property &amp; Client Agreement Parties" styleClass="section-title"/>

                        <VBox spacing="4">
                            <Label text="Target Property ID" styleClass="label-soft"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="propertyIdField" promptText="e.g. 1042" HBox.hgrow="ALWAYS"/>
                                <Button text="Lookup Property" styleClass="button, button-secondary" onAction="#handleLoadProperty"/>
                            </HBox>
                            <Label fx:id="propertySummaryLabel" styleClass="label-soft" style="-fx-font-weight: 600; -fx-text-fill: -c-primary;"/>
                            <Label fx:id="propertyError" styleClass="field-error" managed="false" visible="false"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Client Account Email" styleClass="label-soft"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="clientEmailField" promptText="client@example.com" HBox.hgrow="ALWAYS"/>
                                <Button text="Find Client" styleClass="button, button-secondary" onAction="#handleFindClient"/>
                            </HBox>
                            <Label fx:id="clientSummaryLabel" styleClass="label-soft" style="-fx-font-weight: 600; -fx-text-fill: -c-primary;"/>
                            <Label fx:id="clientError" styleClass="field-error" managed="false" visible="false"/>
                        </VBox>
                    </VBox>

                    <!-- 2. Financial Terms -->
                    <VBox styleClass="card" spacing="14">
                        <Label text="2. Contract Terms &amp; Valuation" styleClass="section-title"/>

                        <HBox spacing="14">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Contract Type" styleClass="label-soft"/>
                                <ComboBox fx:id="contractTypeCombo" maxWidth="Infinity"/>
                            </VBox>
                            <VBox fx:id="totalAmountBox" spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Sale Total Price ($ USD)" styleClass="label-soft"/>
                                <TextField fx:id="totalAmountField" promptText="e.g. 350,000"/>
                                <Label fx:id="totalAmountError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>
                        </HBox>

                        <!-- Lease Specific Fields -->
                        <VBox fx:id="leaseBox" spacing="14" managed="false" visible="false">
                            <HBox spacing="14">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Monthly Rent ($ USD / month)" styleClass="label-soft"/>
                                    <TextField fx:id="monthlyRentField" promptText="e.g. 1,800"/>
                                    <Label fx:id="monthlyRentError" styleClass="field-error" managed="false" visible="false"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Lease Term (Months)" styleClass="label-soft"/>
                                    <TextField fx:id="termMonthsField" promptText="e.g. 12"/>
                                    <Label fx:id="termMonthsError" styleClass="field-error" managed="false" visible="false"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <HBox spacing="14">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Contract Effective Start Date" styleClass="label-soft"/>
                                <DatePicker fx:id="startDatePicker" maxWidth="Infinity"/>
                                <Label fx:id="startDateError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Payment Frequency" styleClass="label-soft"/>
                                <ComboBox fx:id="paymentFrequencyCombo" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Installment Count" styleClass="label-soft"/>
                                <TextField fx:id="installmentCountField" promptText="e.g. 4"/>
                                <Label fx:id="installmentCountError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Submit Draft CTA -->
                    <Button text="Create the draft" styleClass="button, button-primary"
                            maxWidth="Infinity" prefHeight="42" style="-fx-font-weight: 700; -fx-font-size: 14px;"
                            onAction="#handleDraft"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </VBox>
</ScrollPane>
