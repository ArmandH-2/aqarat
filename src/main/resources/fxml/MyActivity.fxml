<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.MyActivityController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="0" right="6" bottom="28" left="0"/>
        </padding>

        <!-- Both lists size to their contents. A fixed height left a card with one
             reservation in it two thirds empty, which reads as something failing to
             load rather than as a short list. The controller sets the height from
             the row count. -->
        <VBox styleClass="card" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Reservations" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                <Label text="A deposit holds a property for 48 hours" styleClass="hint"/>
            </HBox>
            <ListView fx:id="reservationList" minHeight="0"/>
        </VBox>

        <VBox styleClass="card" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Viewings" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                <Label text="An agent comes with you" styleClass="hint"/>
            </HBox>
            <ListView fx:id="viewingList" minHeight="0"/>
        </VBox>
    </VBox>
</ScrollPane>
