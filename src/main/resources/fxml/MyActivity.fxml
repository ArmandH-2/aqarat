<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.MyActivityController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="0" right="6" bottom="28" left="0"/>
        </padding>

        <!-- Active Reservations Section -->
        <VBox styleClass="card" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Active &amp; Past Reservations" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                <Label text="48h exclusivity lock" styleClass="hint"/>
            </HBox>
            <ListView fx:id="reservationList" prefHeight="220" minHeight="180"/>
        </VBox>

        <!-- Scheduled Viewings Section -->
        <VBox styleClass="card" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Scheduled Viewings" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                <Label text="Accompanied by licensed agents" styleClass="hint"/>
            </HBox>
            <ListView fx:id="viewingList" prefHeight="260" minHeight="200"/>
        </VBox>
    </VBox>
</ScrollPane>
