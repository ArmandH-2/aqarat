<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.ListingsController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="30" right="40" bottom="34" left="40"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="18">
            <!-- Header -->
            <VBox spacing="5">
                <Label text="INVENTORY" styleClass="eyebrow"/>
                <Label text="Everything on the market" styleClass="display-title"/>
                <Label text="Published listings, reserved holds and closed deals. A property changes status by someone acting on it, never by an edit to this list." styleClass="hint" wrapText="true" maxWidth="760"/>
            </VBox>

            <!-- Filter Card -->
            <VBox styleClass="card" spacing="12">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="titleField" promptText="Search by title"
                               HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#handleSearch"/>
                    <Button text="Search" styleClass="button, button-primary" onAction="#handleSearch"/>
                    <Button fx:id="filtersButton" text="All filters" styleClass="button, button-secondary"
                            onAction="#handleToggleFilters"/>
                    <Button text="Clear" styleClass="button, button-ghost"
                            onAction="#handleClearFilters"/>
                </HBox>

                <!-- Eight controls held permanently open cost the height of two
                     listings before the first result, which is what made this
                     panel read as a query form. Discover collapses the same set. -->
                <VBox fx:id="filterPanel" spacing="12" managed="false" visible="false">
                <HBox spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="District" styleClass="label-soft"/>
                        <ComboBox fx:id="districtCombo" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Property type" styleClass="label-soft"/>
                        <ComboBox fx:id="typeCombo" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Deal type" styleClass="label-soft"/>
                        <ComboBox fx:id="dealTypeCombo" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Bedrooms" styleClass="label-soft"/>
                        <ComboBox fx:id="bedroomsCombo" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Min price ($)" styleClass="label-soft"/>
                        <TextField fx:id="minPriceField"/>
                        <Label fx:id="minPriceError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Max price ($)" styleClass="label-soft"/>
                        <TextField fx:id="maxPriceField"/>
                        <Label fx:id="maxPriceError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Min area (m²)" styleClass="label-soft"/>
                        <TextField fx:id="minAreaField"/>
                        <Label fx:id="minAreaError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Max area (m²)" styleClass="label-soft"/>
                        <TextField fx:id="maxAreaField"/>
                        <Label fx:id="maxAreaError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>
                </HBox>
                </VBox>
            </VBox>

            <!-- Listings List -->
            <ListView fx:id="propertyList" styleClass="page-list"/>

            <!-- Pagination Controls -->
            <HBox spacing="16" alignment="CENTER">
                <Button fx:id="previousButton" text="← Previous" styleClass="button, button-secondary"
                        onAction="#handlePrevious"/>
                <Button fx:id="nextButton" text="Next →" styleClass="button, button-secondary"
                        onAction="#handleNext"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
