<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.syntropyhq.aqarat.controller.RegisterController"
           styleClass="content">
    <VBox styleClass="card" spacing="12" maxWidth="360">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        <Label text="Create an account" styleClass="page-title"/>

        <VBox spacing="4">
            <Label text="Full name" styleClass="label-soft"/>
            <TextField fx:id="fullNameField"/>
            <Label fx:id="fullNameError" styleClass="field-error" managed="false" visible="false"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Email" styleClass="label-soft"/>
            <TextField fx:id="emailField"/>
            <Label fx:id="emailError" styleClass="field-error" managed="false" visible="false"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Phone" styleClass="label-soft"/>
            <TextField fx:id="phoneField"/>
            <Label fx:id="phoneError" styleClass="field-error" managed="false" visible="false"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Password" styleClass="label-soft"/>
            <PasswordField fx:id="passwordField"/>
            <Label fx:id="passwordError" styleClass="field-error" managed="false" visible="false"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Confirm password" styleClass="label-soft"/>
            <PasswordField fx:id="confirmPasswordField"/>
            <Label fx:id="confirmPasswordError" styleClass="field-error" managed="false" visible="false"/>
        </VBox>

        <Button text="Register" styleClass="button, button-primary" maxWidth="Infinity"
                onAction="#handleRegister"/>

        <Hyperlink text="Already have an account? Sign in" onAction="#handleLoginLink"/>
    </VBox>
</StackPane>
