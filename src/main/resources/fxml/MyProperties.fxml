<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane styleClass="panel" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.MyPropertiesController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="0" right="6" bottom="28" left="0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="My Properties" styleClass="page-title"/>
                <Label text="Manage your submitted properties, review responses, and listings" styleClass="hint"/>
            </VBox>
            <Button text="+ Submit new property" styleClass="button, button-primary" onAction="#handleSubmitNew"/>
        </HBox>

        <!-- Summary KPI Row -->
        <HBox spacing="14">
            <VBox styleClass="stat-tile" spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="totalCountLabel" styleClass="metric-value" text="0"/>
                <Label text="Total submissions" styleClass="hint"/>
            </VBox>
            <VBox styleClass="stat-tile" spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="activeCountLabel" styleClass="metric-value" style="-fx-text-fill: -c-good;" text="0"/>
                <Label text="Active listings" styleClass="hint"/>
            </VBox>
            <VBox styleClass="stat-tile" spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="reviewCountLabel" styleClass="metric-value" style="-fx-text-fill: -c-warn;" text="0"/>
                <Label text="Pending review" styleClass="hint"/>
            </VBox>
            <VBox styleClass="stat-tile" spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="needsInfoCountLabel" styleClass="metric-value" style="-fx-text-fill: -c-bad;" text="0"/>
                <Label text="Needs info" styleClass="hint"/>
            </VBox>
        </HBox>

        <!-- Properties List -->
        <ListView fx:id="propertyList" VBox.vgrow="ALWAYS" minHeight="450"/>
    </VBox>
</ScrollPane>
