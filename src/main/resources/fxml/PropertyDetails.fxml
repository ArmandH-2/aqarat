<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import co.syntropyhq.aqarat.util.RequiredLabel?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.PropertyDetailsController"
            fitToWidth="true" hbarPolicy="NEVER">

    <VBox spacing="0">

        <!-- Back strip -->
        <HBox styleClass="detail-backstrip" alignment="CENTER_LEFT">
            <Button text="← Back to results" styleClass="button, button-ghost" onAction="#handleBack"/>
        </HBox>

        <!-- ===================== Gallery =====================
             The photograph is the product. It gets the top of the page at full
             width, not a labelled box inside a card. -->
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="44" bottom="0" left="44"/>
            </padding>

            <StackPane fx:id="mainPhotoContainer" styleClass="detail-hero-photo"
                       minHeight="420" prefHeight="420" maxHeight="420" alignment="TOP_LEFT">
                <ImageView fx:id="mainImageView" preserveRatio="false"/>
                <Label fx:id="statusPill" styleClass="pill-on-photo">
                    <StackPane.margin>
                        <Insets top="16" left="16"/>
                    </StackPane.margin>
                </Label>
            </StackPane>

            <HBox fx:id="thumbnailStrip" spacing="10" alignment="CENTER_LEFT"/>
        </VBox>

        <!-- ===================== Body ===================== -->
        <HBox spacing="34" alignment="TOP_LEFT">
            <padding>
                <Insets top="26" right="44" bottom="34" left="44"/>
            </padding>

            <!-- Left: the property -->
            <VBox spacing="26" HBox.hgrow="ALWAYS">

                <VBox spacing="7">
                    <Label fx:id="districtSubtitle" styleClass="eyebrow"/>
                    <Label fx:id="titleLabel" styleClass="display-title-lg" wrapText="true"/>
                </VBox>

                <!-- Specification strip. Five figures on rules, rather than
                     twelve label-over-value pairs in a grid. -->
                <HBox styleClass="spec-strip" alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="BEDROOMS" styleClass="spec-strip-label"/>
                        <Label fx:id="bedroomsValue" styleClass="spec-strip-value"/>
                    </VBox>
                    <Region styleClass="rule-v" minHeight="38" prefHeight="38"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <padding><Insets left="24"/></padding>
                        <Label text="BATHROOMS" styleClass="spec-strip-label"/>
                        <Label fx:id="bathroomsValue" styleClass="spec-strip-value"/>
                    </VBox>
                    <Region styleClass="rule-v" minHeight="38" prefHeight="38"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <padding><Insets left="24"/></padding>
                        <Label text="AREA" styleClass="spec-strip-label"/>
                        <Label fx:id="areaValue" styleClass="spec-strip-value"/>
                    </VBox>
                    <Region styleClass="rule-v" minHeight="38" prefHeight="38"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <padding><Insets left="24"/></padding>
                        <Label text="FLOOR" styleClass="spec-strip-label"/>
                        <Label fx:id="floorValue" styleClass="spec-strip-value"/>
                    </VBox>
                    <Region styleClass="rule-v" minHeight="38" prefHeight="38"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <padding><Insets left="24"/></padding>
                        <Label text="BUILT" styleClass="spec-strip-label"/>
                        <Label fx:id="yearBuiltValue" styleClass="spec-strip-value"/>
                    </VBox>
                </HBox>

                <VBox spacing="9" maxWidth="660">
                    <Label text="About this property" styleClass="section-title"/>
                    <Label fx:id="descriptionValue" styleClass="body-relaxed" wrapText="true"/>
                </VBox>

                <VBox spacing="11">
                    <Label text="Features" styleClass="section-title"/>
                    <FlowPane fx:id="amenitiesPane" hgap="9" vgap="9"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Address" styleClass="section-title"/>
                    <Label fx:id="addressValue" styleClass="body" wrapText="true"/>
                </VBox>
            </VBox>

            <!-- Right: price and the one thing to do next -->
            <VBox spacing="14" minWidth="330" prefWidth="330" maxWidth="360">

                <VBox styleClass="card" spacing="18">
                    <VBox spacing="3">
                        <Label fx:id="priceValue" styleClass="price-display-lg"/>
                        <Label fx:id="pricePerSqmLabel" styleClass="hint"/>
                    </VBox>

                    <VBox fx:id="actionsBox" spacing="18" visible="false" managed="false">
                        <!-- Fields, then the action. The button sat above its own inputs,
                             which asks someone to submit a form they have not filled in.
                             Stacked rather than side by side: this rail is 330px wide, and
                             a DatePicker and a ComboBox sharing it leaves the time as a
                             bare arrow with its value clipped to an ellipsis. -->
                        <VBox spacing="10">
                            <VBox spacing="4">
                                <RequiredLabel text="Date"/>
                                <DatePicker fx:id="viewingDatePicker" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="4">
                                <RequiredLabel text="Time"/>
                                <ComboBox fx:id="viewingTimeCombo" maxWidth="Infinity" promptText="Choose a slot"/>
                            </VBox>
                            <Label fx:id="viewingError" styleClass="field-error" managed="false" visible="false" wrapText="true"/>
                            <Button text="Request a viewing" styleClass="button, button-primary"
                                    maxWidth="Infinity" onAction="#handleRequestViewing"/>
                            <Label styleClass="hint" wrapText="true"
                                   text="Free, and accompanied by the listing agent."/>
                        </VBox>

                        <Region styleClass="rule-h"/>

                        <VBox spacing="9">
                            <Label styleClass="hint" wrapText="true"
                                   text="Ready to commit? A deposit holds this property for 48 hours while contracts are drafted."/>
                            <VBox spacing="4">
                                <RequiredLabel text="Deposit ($)"/>
                                <TextField fx:id="depositField" promptText="5,000"/>
                                <Label fx:id="depositError" styleClass="field-error" managed="false" visible="false" wrapText="true"/>
                            </VBox>
                            <Button text="Reserve with a deposit" styleClass="button, button-secondary"
                                    maxWidth="Infinity" onAction="#handleReserve"/>
                        </VBox>
                    </VBox>

                    <Label fx:id="unavailableNote" styleClass="hint" wrapText="true"
                           managed="false" visible="false"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
