<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.UsersController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="30" right="40" bottom="34" left="40"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="20">
            <!-- Header -->
            <VBox spacing="5">
                <Label text="ADMINISTRATION" styleClass="eyebrow"/>
                <Label text="People and access" styleClass="display-title"/>
                <Label text="Three roles. Whether a customer is an owner or a client is decided by what they hold, so someone selling one property and renting another needs one account, not two." styleClass="hint" wrapText="true" maxWidth="760"/>
            </VBox>

            <!-- Create New User Form Card -->
            <VBox styleClass="card" spacing="14">
                <Label text="Add someone" styleClass="section-title"/>

                <GridPane hgap="14" vgap="12">
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Full Name" styleClass="label-soft"/>
                        <TextField fx:id="fullNameField" promptText="e.g. Layla Haddad"/>
                        <Label fx:id="fullNameError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Email Address" styleClass="label-soft"/>
                        <TextField fx:id="emailField" promptText="layla@aqarat.com"/>
                        <Label fx:id="emailError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Phone Number" styleClass="label-soft"/>
                        <TextField fx:id="phoneField" promptText="+961 70 123456"/>
                        <Label fx:id="phoneError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Password" styleClass="label-soft"/>
                        <PasswordField fx:id="passwordField" promptText="Minimum 8 characters"/>
                        <Label fx:id="passwordError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Role" styleClass="label-soft"/>
                        <ComboBox fx:id="roleCombo" maxWidth="Infinity"/>
                    </VBox>

                    <HBox spacing="10" alignment="BOTTOM_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Button text="Create account" styleClass="button, button-primary"
                                prefHeight="36" onAction="#handleCreate"/>
                    </HBox>
                </GridPane>
            </VBox>

            <!-- User Accounts Directory Card -->
            <VBox styleClass="card" spacing="12">
                <Label text="Everyone with an account" styleClass="section-title"/>
                <ListView fx:id="userList" styleClass="page-list"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
