<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.syntropyhq.aqarat.controller.UsersController"
      styleClass="content" spacing="24">
    <Label text="Users" styleClass="page-title"/>
    <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

    <VBox fx:id="contentBox" spacing="24" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="12">
            <Label text="Create account" styleClass="section-title"/>
            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Full name" styleClass="label-soft"/>
                    <TextField fx:id="fullNameField"/>
                    <Label fx:id="fullNameError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Email" styleClass="label-soft"/>
                    <TextField fx:id="emailField"/>
                    <Label fx:id="emailError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Phone" styleClass="label-soft"/>
                    <TextField fx:id="phoneField"/>
                    <Label fx:id="phoneError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>
            </HBox>
            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Role" styleClass="label-soft"/>
                    <ComboBox fx:id="roleCombo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Initial password" styleClass="label-soft"/>
                    <PasswordField fx:id="passwordField"/>
                    <Label fx:id="passwordError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>
            </HBox>
            <Button text="Create account" styleClass="button, button-primary" onAction="#handleCreate"/>
        </VBox>

        <ListView fx:id="userList" VBox.vgrow="ALWAYS"/>
    </VBox>
</VBox>
