<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.PortfolioController"
            fitToWidth="true" hbarPolicy="NEVER">

    <VBox spacing="24">
        <padding>
            <Insets top="30" right="40" bottom="34" left="40"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="24">

            <VBox spacing="3">
                <Label fx:id="ownerLabel" styleClass="eyebrow"/>
                <Label text="Your portfolio" styleClass="display-title"/>
            </VBox>

            <!-- ============ Needs you ============
                 The reason a person opens this screen: what is about to lapse,
                 what is owed, what an agent has asked for. Previously each of
                 these was a word inside a row of a list. -->
            <VBox fx:id="attentionSection" spacing="11" managed="false" visible="false">
                <Label text="Needs you" styleClass="section-title"/>
                <FlowPane fx:id="attentionBar" hgap="14" vgap="14" maxWidth="Infinity"/>
            </VBox>

            <!-- ============ Segments ============ -->
            <HBox spacing="0" styleClass="segment-bar" alignment="CENTER_LEFT">
                <Button fx:id="propertiesTab" text="Properties" styleClass="tab-pill-button, active"
                        onAction="#showProperties"/>
                <Region minWidth="24" prefWidth="24"/>
                <Button fx:id="contractsTab" text="Contracts" styleClass="tab-pill-button"
                        onAction="#showContracts"/>
                <Region minWidth="24" prefWidth="24"/>
                <Button fx:id="activityTab" text="Viewings and reservations" styleClass="tab-pill-button"
                        onAction="#showActivity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Submit a property" styleClass="button, button-primary"
                        onAction="#handleSubmitNew"/>
            </HBox>

            <!-- Deliberately not a page-list. The embedded panel varies in
                 height, and forcing it to the viewport leaves a screen of empty
                 canvas under a short one. It sizes to its own content and the
                 page scrolls around it. -->
            <StackPane fx:id="segmentContent"/>
        </VBox>
    </VBox>
</ScrollPane>
