<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.syntropyhq.aqarat.controller.AuditLogController"
      styleClass="content" spacing="24">
    <Label text="Audit log" styleClass="page-title"/>
    <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

    <VBox fx:id="contentBox" spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="12">
            <Label text="Filters" styleClass="section-title"/>
            <HBox spacing="12">
                <VBox spacing="4">
                    <Label text="Entity type" styleClass="label-soft"/>
                    <TextField fx:id="entityTypeField" promptText="e.g. contract"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Action" styleClass="label-soft"/>
                    <TextField fx:id="actionField" promptText="e.g. ACTIVATE"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="User id" styleClass="label-soft"/>
                    <TextField fx:id="userIdField"/>
                    <Label fx:id="userIdError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="From" styleClass="label-soft"/>
                    <DatePicker fx:id="fromDatePicker"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="To" styleClass="label-soft"/>
                    <DatePicker fx:id="toDatePicker"/>
                </VBox>
            </HBox>
            <HBox spacing="8">
                <Button text="Apply filters" styleClass="button, button-primary"
                        onAction="#handleApplyFilters"/>
                <Button text="Export CSV" styleClass="button, button-secondary"
                        onAction="#handleExport"/>
            </HBox>
        </VBox>

        <TableView fx:id="auditTable" VBox.vgrow="ALWAYS"/>

        <HBox spacing="8">
            <Button fx:id="previousButton" text="Previous" styleClass="button, button-secondary"
                    onAction="#handlePrevious"/>
            <Button fx:id="nextButton" text="Next" styleClass="button, button-secondary"
                    onAction="#handleNext"/>
        </HBox>
    </VBox>
</VBox>
