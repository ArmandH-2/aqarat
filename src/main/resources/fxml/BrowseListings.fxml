<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.BrowseListingsController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="0" right="6" bottom="28" left="0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Browse Listings" styleClass="page-title"/>
                <Label text="Discover available properties for sale and rent across Lebanon" styleClass="hint"/>
            </VBox>
            <Label fx:id="resultsCountLabel" styleClass="pill, pill-info"/>
        </HBox>

        <!-- Filter Card -->
        <VBox styleClass="card" spacing="14">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="titleField" promptText="Search properties by title or location keywords..."
                           HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Search" styleClass="button, button-primary" onAction="#handleSearch"/>
                <Button text="Clear filters" styleClass="button, button-secondary"
                        onAction="#handleClearFilters"/>
            </HBox>

            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="District" styleClass="label-soft"/>
                    <ComboBox fx:id="districtCombo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Property type" styleClass="label-soft"/>
                    <ComboBox fx:id="typeCombo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Deal type" styleClass="label-soft"/>
                    <ComboBox fx:id="dealTypeCombo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Bedrooms" styleClass="label-soft"/>
                    <ComboBox fx:id="bedroomsCombo" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Min price ($)" styleClass="label-soft"/>
                    <TextField fx:id="minPriceField" promptText="e.g. 100,000"/>
                    <Label fx:id="minPriceError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Max price ($)" styleClass="label-soft"/>
                    <TextField fx:id="maxPriceField" promptText="e.g. 500,000"/>
                    <Label fx:id="maxPriceError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Min area (m²)" styleClass="label-soft"/>
                    <TextField fx:id="minAreaField" promptText="e.g. 80"/>
                    <Label fx:id="minAreaError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="Max area (m²)" styleClass="label-soft"/>
                    <TextField fx:id="maxAreaField" promptText="e.g. 300"/>
                    <Label fx:id="maxAreaError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Results Grid -->
        <VBox fx:id="resultsBox" spacing="12"/>

        <!-- Pagination Controls -->
        <HBox spacing="16" alignment="CENTER">
            <Button fx:id="previousButton" text="← Previous" styleClass="button, button-secondary"
                    onAction="#handlePrevious"/>
            <Label fx:id="pageIndicatorLabel" styleClass="label-soft" text="Page 1"/>
            <Button fx:id="nextButton" text="Next →" styleClass="button, button-secondary"
                    onAction="#handleNext"/>
        </HBox>
    </VBox>
</ScrollPane>
