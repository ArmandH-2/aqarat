<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.SubmitPropertyController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="panel">

    <VBox spacing="24">
        <padding>
            <Insets bottom="34" right="6"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="24">

            <VBox spacing="3">
                <Label text="SUBMIT A PROPERTY" styleClass="eyebrow"/>
                <Label text="Tell us what you have" styleClass="display-title"/>
            </VBox>

            <HBox spacing="30" alignment="TOP_LEFT">

                <!-- ================= The form ================= -->
                <VBox spacing="20" HBox.hgrow="ALWAYS" maxWidth="720">

                    <VBox styleClass="card" spacing="15">
                        <Label text="The basics" styleClass="section-title"/>

                        <VBox spacing="5">
                            <Label text="Property title" styleClass="label-soft"/>
                            <TextField fx:id="titleField" promptText="Modern three-bedroom apartment with sea view"/>
                            <Label fx:id="titleError" styleClass="field-error" managed="false" visible="false"/>
                        </VBox>

                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="District" styleClass="label-soft"/>
                                <ComboBox fx:id="districtCombo" maxWidth="Infinity" promptText="Select a district"/>
                                <Label fx:id="districtError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Property type" styleClass="label-soft"/>
                                <ComboBox fx:id="propertyTypeCombo" maxWidth="Infinity" promptText="Select a type"/>
                                <Label fx:id="propertyTypeError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="5">
                            <Label text="Address or neighbourhood" styleClass="label-soft"/>
                            <TextField fx:id="addressLineField" promptText="Bliss Street, Ras Beirut"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Description" styleClass="label-soft"/>
                            <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true"
                                      promptText="What would you tell someone standing at the front door?"/>
                        </VBox>
                    </VBox>

                    <VBox styleClass="card" spacing="15">
                        <Label text="Specifications" styleClass="section-title"/>

                        <GridPane hgap="12" vgap="13">
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Area (m²)" styleClass="label-soft"/>
                                <TextField fx:id="areaField" promptText="175"/>
                                <Label fx:id="areaError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Bedrooms" styleClass="label-soft"/>
                                <TextField fx:id="bedroomsField" promptText="3"/>
                                <Label fx:id="bedroomsError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Bathrooms" styleClass="label-soft"/>
                                <TextField fx:id="bathroomsField" promptText="2"/>
                                <Label fx:id="bathroomsError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>

                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Floor" styleClass="label-soft"/>
                                <TextField fx:id="floorNumberField" promptText="4"/>
                                <Label fx:id="floorNumberError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Floors in building" styleClass="label-soft"/>
                                <TextField fx:id="totalFloorsField" promptText="8"/>
                                <Label fx:id="totalFloorsError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <Label text="Year built" styleClass="label-soft"/>
                                <TextField fx:id="yearBuiltField" promptText="2018"/>
                                <Label fx:id="yearBuiltError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>
                        </GridPane>

                        <VBox spacing="8">
                            <Label text="Features" styleClass="label-soft"/>
                            <FlowPane hgap="18" vgap="10">
                                <CheckBox fx:id="parkingCheck" text="Dedicated parking"/>
                                <CheckBox fx:id="elevatorCheck" text="Lift"/>
                                <CheckBox fx:id="balconyCheck" text="Balcony or terrace"/>
                                <CheckBox fx:id="furnishedCheck" text="Furnished"/>
                            </FlowPane>
                        </VBox>
                    </VBox>

                    <VBox styleClass="card" spacing="15">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Photographs" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="photoCountBadge" styleClass="pill, pill-neutral"/>
                        </HBox>
                        <Label styleClass="hint" wrapText="true"
                               text="Listings with photographs get far more viewings. Three or more is a good target."/>
                        <FlowPane fx:id="photosContainer" hgap="9" vgap="9"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Add photographs" styleClass="button, button-secondary"
                                    onAction="#handleAddPhotos"/>
                            <Label fx:id="photoListLabel" styleClass="hint"/>
                        </HBox>
                    </VBox>

                    <VBox styleClass="card" spacing="15">
                        <Label text="Price and terms" styleClass="section-title"/>

                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Deal type" styleClass="label-soft"/>
                                <ComboBox fx:id="dealTypeCombo" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label fx:id="askingPriceLabel" text="Asking price ($)" styleClass="label-soft"/>
                                <TextField fx:id="askingPriceField" promptText="250,000"/>
                                <Label fx:id="askingPriceError" styleClass="field-error" managed="false" visible="false"/>
                            </VBox>
                        </HBox>

                        <VBox fx:id="termsBox" spacing="12" managed="false" visible="false">
                            <HBox spacing="12">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Minimum term (months)" styleClass="label-soft"/>
                                    <TextField fx:id="minTermField" promptText="12"/>
                                    <Label fx:id="minTermError" styleClass="field-error" managed="false" visible="false"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Maximum term (months)" styleClass="label-soft"/>
                                    <TextField fx:id="maxTermField" promptText="36"/>
                                    <Label fx:id="maxTermError" styleClass="field-error" managed="false" visible="false"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button text="Submit for review" styleClass="button, button-primary"
                                onAction="#handleSubmit"/>
                        <Label styleClass="hint" wrapText="true"
                               text="An agent reviews every submission before it is published."/>
                    </HBox>
                </VBox>

                <!-- ================= Live valuation =================
                     The system's distinguishing claim is that a number can be
                     traced to its source. This is where an owner sees that
                     happen, while they are still deciding what to ask. -->
                <VBox fx:id="valuationPanel" styleClass="card" spacing="18"
                      minWidth="360" prefWidth="380" maxWidth="420">

                    <VBox spacing="4">
                        <Label text="AQARAT ESTIMATE" styleClass="eyebrow"/>
                        <Label fx:id="estimateValue" styleClass="display-title-lg" text="—"/>
                        <Label fx:id="estimateState" styleClass="hint" wrapText="true"
                               text="Enter a district, property type and area, and an estimate appears here."/>
                    </VBox>

                    <VBox fx:id="estimateDetail" spacing="18" managed="false" visible="false">

                        <HBox spacing="9" alignment="CENTER_LEFT">
                            <Label fx:id="plausibilityPill" styleClass="pill"/>
                        </HBox>

                        <VBox spacing="8">
                            <HBox fx:id="rangeTrack" styleClass="range-track" alignment="CENTER_LEFT"/>
                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="lowerBoundLabel" styleClass="hint"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="upperBoundLabel" styleClass="hint"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="How this was reached" styleClass="label-soft"/>
                            <VBox fx:id="factorsBox" spacing="8"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label fx:id="comparablesHeading" styleClass="label-soft"/>
                            <VBox fx:id="comparablesBox" spacing="7"/>
                        </VBox>

                        <Label styleClass="hint" wrapText="true"
                               text="An estimate, not an appraisal. Your agent agrees the published price with you."/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
