<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane styleClass="panel" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.SubmitPropertyController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="0" right="6" bottom="36" left="0"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="20">
            <!-- Header -->
            <VBox spacing="2">
                <Label text="Submit a Property" styleClass="page-title"/>
                <Label text="Enter property specifications, upload photos, and set your asking price for agent review" styleClass="hint"/>
            </VBox>

            <!-- 1. Identity & Location Card -->
            <VBox styleClass="card" spacing="14">
                <Label text="1. Basic Information &amp; Location" styleClass="section-title"/>

                <VBox spacing="4">
                    <Label text="Property Title" styleClass="label-soft"/>
                    <TextField fx:id="titleField" promptText="e.g. Modern 3-Bedroom Apartment with Sea View"/>
                    <Label fx:id="titleError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>

                <HBox spacing="14">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="District" styleClass="label-soft"/>
                        <ComboBox fx:id="districtCombo" maxWidth="Infinity" promptText="Select District"/>
                        <Label fx:id="districtError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Property Type" styleClass="label-soft"/>
                        <ComboBox fx:id="propertyTypeCombo" maxWidth="Infinity" promptText="Select Type"/>
                        <Label fx:id="propertyTypeError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>
                </HBox>

                <VBox spacing="4">
                    <Label text="Address Line / Neighborhood" styleClass="label-soft"/>
                    <TextField fx:id="addressLineField" promptText="e.g. Bliss Street, Ras Beirut"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Full Description" styleClass="label-soft"/>
                    <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true"
                              promptText="Describe property condition, renovations, views, and surroundings..."/>
                </VBox>
            </VBox>

            <!-- 2. Specifications Card -->
            <VBox styleClass="card" spacing="14">
                <Label text="2. Specifications &amp; Amenities" styleClass="section-title"/>

                <GridPane hgap="14" vgap="12">
                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Area (m²)" styleClass="label-soft"/>
                        <TextField fx:id="areaField" promptText="e.g. 175"/>
                        <Label fx:id="areaError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Bedrooms" styleClass="label-soft"/>
                        <TextField fx:id="bedroomsField" promptText="e.g. 3"/>
                        <Label fx:id="bedroomsError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Bathrooms" styleClass="label-soft"/>
                        <TextField fx:id="bathroomsField" promptText="e.g. 2"/>
                        <Label fx:id="bathroomsError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Floor Number" styleClass="label-soft"/>
                        <TextField fx:id="floorNumberField" promptText="e.g. 4"/>
                        <Label fx:id="floorNumberError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Total Building Floors" styleClass="label-soft"/>
                        <TextField fx:id="totalFloorsField" promptText="e.g. 8"/>
                        <Label fx:id="totalFloorsError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <Label text="Year Built" styleClass="label-soft"/>
                        <TextField fx:id="yearBuiltField" promptText="e.g. 2018"/>
                        <Label fx:id="yearBuiltError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>
                </GridPane>

                <VBox spacing="6">
                    <Label text="Features &amp; Amenities" styleClass="label-soft"/>
                    <HBox spacing="20">
                        <CheckBox fx:id="parkingCheck" text="Dedicated Parking"/>
                        <CheckBox fx:id="elevatorCheck" text="Elevator"/>
                        <CheckBox fx:id="balconyCheck" text="Balcony / Terrace"/>
                        <CheckBox fx:id="furnishedCheck" text="Furnished"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- 3. Financial & Deal Terms Card -->
            <VBox styleClass="card" spacing="14">
                <Label text="3. Pricing &amp; Deal Terms" styleClass="section-title"/>

                <HBox spacing="14">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Deal Type" styleClass="label-soft"/>
                        <ComboBox fx:id="dealTypeCombo" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="askingPriceLabel" text="Asking Price ($ USD)" styleClass="label-soft"/>
                        <TextField fx:id="askingPriceField" promptText="e.g. 250,000"/>
                        <Label fx:id="askingPriceError" styleClass="field-error" managed="false" visible="false"/>
                    </VBox>
                </HBox>

                <!-- Lease Terms Box for RENT -->
                <VBox fx:id="termsBox" spacing="12">
                    <HBox spacing="14">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Minimum Lease Term (Months)" styleClass="label-soft"/>
                            <TextField fx:id="minTermField" promptText="e.g. 12"/>
                            <Label fx:id="minTermError" styleClass="field-error" managed="false" visible="false"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Maximum Lease Term (Months)" styleClass="label-soft"/>
                            <TextField fx:id="maxTermField" promptText="e.g. 36"/>
                            <Label fx:id="maxTermError" styleClass="field-error" managed="false" visible="false"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- 4. Photos Card -->
            <VBox styleClass="card" spacing="12">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="4. High-Resolution Photos" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                    <Label text="Up to 8 photos (JPG, PNG)" styleClass="hint"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="+ Select photos from disk" styleClass="button, button-secondary"
                            onAction="#handleAddPhotos"/>
                    <Label fx:id="photoCountBadge" styleClass="pill, pill-neutral" text="0 / 8 photos"/>
                </HBox>
                <FlowPane fx:id="photosContainer" hgap="10" vgap="10"/>
                <Label fx:id="photoListLabel" text="No photos chosen yet. High-quality photos increase buyer inquiries by 3x." styleClass="hint" wrapText="true"/>
            </VBox>

            <!-- Submit Button -->
            <Button text="Submit Property for Review →" styleClass="button, button-primary"
                    maxWidth="Infinity" prefHeight="44" style="-fx-font-size: 14px; -fx-font-weight: 700;"
                    onAction="#handleSubmit"/>
        </VBox>
    </VBox>
</ScrollPane>
