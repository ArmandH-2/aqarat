<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.ReviewSubmissionController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="30" right="40" bottom="34" left="40"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="20">
            <!-- Header Bar -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="← Back to the queue" styleClass="button, button-secondary" onAction="#handleBack"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- The whole file on this property: the owner's evidence, who has
                     asked to see it, and everything recorded so far. -->
                <Button text="Property file" styleClass="button, button-secondary"
                        onAction="#handleOpenDossier"/>
            </HBox>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="titleLabel" styleClass="hero-title"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="districtSubtitle" styleClass="label-soft"/>
                        <Label text="·" styleClass="hint"/>
                        <Label fx:id="statusPill" styleClass="pill"/>
                    </HBox>
                </VBox>
                <VBox spacing="2" alignment="CENTER_RIGHT">
                    <Label fx:id="askingPriceCaption" styleClass="eyebrow" text="ASKING PRICE"/>
                    <Label fx:id="askingPriceValue" styleClass="price-display-lg"/>
                </VBox>
            </HBox>

            <!-- Dual-Pane Centerpiece -->
            <HBox spacing="20">

                <!-- Left Column: Submission Details & Media -->
                <VBox spacing="20" HBox.hgrow="ALWAYS">

                    <!-- Photos Gallery Card -->
                    <VBox styleClass="card" spacing="12">
                        <Label text="Photographs" styleClass="section-title"/>
                        <StackPane fx:id="mainPhotoContainer" prefHeight="320" maxHeight="320"
                                   style="-fx-background-color: -c-surface-subtle; -fx-background-radius: 8px; -fx-border-color: -c-border-subtle; -fx-border-radius: 8px;">
                            <ImageView fx:id="mainImageView" fitHeight="320" preserveRatio="true"/>
                        </StackPane>
                        <ScrollPane fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED"
                                    style="-fx-background-color: transparent; -fx-background: transparent;">
                            <HBox fx:id="thumbnailStrip" spacing="10" alignment="CENTER_LEFT">
                                <padding>
                                    <Insets top="4" bottom="4"/>
                                </padding>
                            </HBox>
                        </ScrollPane>
                        <FlowPane fx:id="galleryBox" hgap="10" vgap="10" managed="false" visible="false"/>
                    </VBox>

                    <!-- Specifications Card -->
                    <VBox styleClass="card" spacing="14">
                        <Label text="Specification" styleClass="section-title"/>

                        <GridPane hgap="20" vgap="12">
                            <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="District" styleClass="hint"/>
                                <Label fx:id="districtValue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Property Type" styleClass="hint"/>
                                <Label fx:id="typeValue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Deal Type" styleClass="hint"/>
                                <Label fx:id="dealTypeValue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                            </VBox>

                            <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Area" styleClass="hint"/>
                                <Label fx:id="areaValue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Bedrooms" styleClass="hint"/>
                                <Label fx:id="bedroomsValue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <Label text="Bathrooms" styleClass="hint"/>
                                <Label fx:id="bathroomsValue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                            </VBox>

                            <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <Label text="Floor Number" styleClass="hint"/>
                                <Label fx:id="floorValue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <Label text="Year Built" styleClass="hint"/>
                                <Label fx:id="yearBuiltValue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Features & Amenities Card -->
                    <VBox styleClass="card" spacing="12">
                        <Label text="Features" styleClass="section-title"/>
                        <FlowPane fx:id="amenitiesPane" hgap="10" vgap="10"/>
                    </VBox>

                    <!-- Location & Description -->
                    <VBox styleClass="card" spacing="12">
                        <Label text="Address and description" styleClass="section-title"/>
                        <VBox spacing="2">
                            <Label text="Address" styleClass="hint"/>
                            <Label fx:id="addressValue" styleClass="body" wrapText="true"/>
                        </VBox>
                        <VBox spacing="2">
                            <Label text="Described by the owner" styleClass="hint"/>
                            <Label fx:id="descriptionValue" styleClass="body" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <!-- Discussion & Messages Thread -->
                    <VBox styleClass="card" spacing="12">
                        <Label text="Discussion with the owner" styleClass="section-title"/>
                        <VBox fx:id="discussionBox" spacing="10"/>
                    </VBox>
                </VBox>

                <!-- Right Column: Valuation Engine & Decision Support -->
                <VBox spacing="20" prefWidth="420" minWidth="380" maxWidth="440">

                    <!-- Valuation Centerpiece Card -->
                    <VBox styleClass="card" spacing="14" style="-fx-border-color: -c-primary; -fx-border-width: 1.5px;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="What the system estimates" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                            <Button text="Re-run" styleClass="button, button-secondary"
                                    style="-fx-font-size: 11px; -fx-pref-height: 28px;"
                                    onAction="#handleRunValuation"/>
                        </HBox>

                        <Label fx:id="noValuationLabel" styleClass="empty-state" wrapText="true"
                               managed="false" visible="false"/>

                        <VBox fx:id="valuationContent" spacing="14">
                            <HBox spacing="16" alignment="CENTER_LEFT" styleClass="card-subtle">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="Estimate" styleClass="hint"/>
                                    <Label fx:id="estimateValue" styleClass="price-display"/>
                                </VBox>
                                <VBox spacing="4" alignment="CENTER_RIGHT">
                                    <Label text="The owner's asking price" styleClass="hint"/>
                                    <Label fx:id="flagPill" styleClass="pill"/>
                                </VBox>
                            </HBox>

                            <Label fx:id="flagCaption" styleClass="hint" wrapText="true"/>

                            <HBox spacing="16">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="Range" styleClass="hint"/>
                                    <Label fx:id="rangeValue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                                </VBox>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="Price per m²" styleClass="hint"/>
                                    <Label fx:id="pricePerSqmValue" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                                </VBox>
                            </HBox>

                            <Label fx:id="evidenceLabel" styleClass="label-soft" wrapText="true"/>
                            <Label fx:id="valuationMetaLabel" styleClass="hint"/>
                        </VBox>
                    </VBox>

                    <!-- Factor Breakdown Card -->
                    <VBox styleClass="card" spacing="12">
                        <Label text="How it was reached" styleClass="section-title"/>
                        <VBox fx:id="factorsBox" spacing="8"/>
                    </VBox>

                    <!-- Comparables Used Card -->
                    <VBox styleClass="card" spacing="12">
                        <Label text="Comparables it reasoned from" styleClass="section-title"/>
                        <VBox fx:id="comparablesBox" spacing="10"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Bottom Decision Card -->
            <VBox fx:id="decisionBox" styleClass="card" spacing="14">
                <Label text="Your decision" styleClass="section-title"/>

                <VBox fx:id="withdrawalReasonBox" spacing="4" managed="false" visible="false" styleClass="card-subtle">
                    <Label text="Why the owner wants it withdrawn" styleClass="label-soft" style="-fx-font-weight: 600;"/>
                    <Label fx:id="withdrawalReasonValue" styleClass="body" wrapText="true"/>
                </VBox>

                <VBox fx:id="noteBox" spacing="4">
                    <Label text="Note to the owner" styleClass="label-soft"/>
                    <TextArea fx:id="noteArea" wrapText="true" prefRowCount="3"
                              promptText="Provide feedback or state reasons for request/rejection..."/>
                    <Label fx:id="noteError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>

                <HBox fx:id="reviewActionsBox" spacing="12">
                    <Button text="Approve and publish" styleClass="button, button-primary"
                            onAction="#handleApprove"/>
                    <Button text="Ask the owner for more" styleClass="button, button-secondary"
                            onAction="#handleRequestInfo"/>
                    <Button text="Reject" styleClass="button, button-danger" onAction="#handleReject"/>
                </HBox>

                <HBox fx:id="withdrawalActionsBox" spacing="12" managed="false" visible="false">
                    <Button text="Accept and delist" styleClass="button, button-danger"
                            onAction="#handleAcceptRemoval"/>
                    <Button text="Decline, keep it listed" styleClass="button, button-secondary"
                            onAction="#handleDeclineRemoval"/>
                </HBox>
            </VBox>

            <Label fx:id="decisionHintLabel" styleClass="hint" managed="false" visible="false"/>
        </VBox>
    </VBox>
</ScrollPane>
