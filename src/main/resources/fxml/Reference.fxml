<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane styleClass="panel" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.ReferenceController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="0" right="6" bottom="36" left="0"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="18">
            <!-- Header -->
            <VBox spacing="2">
                <Label text="System Reference &amp; Configuration" styleClass="page-title"/>
                <Label text="Manage municipal districts, property categories, valuation benchmarks, and global business parameters" styleClass="hint"/>
            </VBox>

            <!-- Segmented Tab Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="districtsTabButton" text="Districts &amp; Price Baselines" styleClass="tab-pill-button, active"
                        onAction="#handleDistrictsTab"/>
                <Button fx:id="typesTabButton" text="Property Categories" styleClass="tab-pill-button"
                        onAction="#handleTypesTab"/>
                <Button fx:id="settingsTabButton" text="System Settings" styleClass="tab-pill-button"
                        onAction="#handleSettingsTab"/>
            </HBox>

            <!-- Districts Tab Box -->
            <VBox fx:id="districtsBox" spacing="16">
                <!-- Add New District Card -->
                <VBox styleClass="card" spacing="12">
                    <Label text="Add New Municipal District" styleClass="section-title"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="District Name" styleClass="label-soft"/>
                            <TextField fx:id="newDistrictNameField" promptText="e.g. Achrafieh"/>
                            <Label fx:id="newDistrictNameError" styleClass="field-error" managed="false" visible="false"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Governorate" styleClass="label-soft"/>
                            <TextField fx:id="newDistrictGovernorateField" promptText="e.g. Beirut"/>
                            <Label fx:id="newDistrictGovernorateError" styleClass="field-error" managed="false" visible="false"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Base Rate ($ / m²)" styleClass="label-soft"/>
                            <TextField fx:id="newDistrictPriceField" promptText="e.g. 2400"/>
                            <Label fx:id="newDistrictPriceError" styleClass="field-error" managed="false" visible="false"/>
                        </VBox>
                        <VBox spacing="4" alignment="BOTTOM_LEFT">
                            <Label text="" styleClass="label-soft"/>
                            <Button text="+ Add District" styleClass="button, button-primary" prefHeight="36" onAction="#handleAddDistrict"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Districts List -->
                <ListView fx:id="districtList" minHeight="450"/>
            </VBox>

            <!-- Property Types Tab Box -->
            <VBox fx:id="typesBox" spacing="16" managed="false" visible="false">
                <VBox styleClass="card" spacing="12">
                    <Label text="Add New Property Category" styleClass="section-title"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Category Name" styleClass="label-soft"/>
                            <TextField fx:id="newTypeNameField" promptText="e.g. Penthouse"/>
                            <Label fx:id="newTypeNameError" styleClass="field-error" managed="false" visible="false"/>
                        </VBox>
                        <VBox spacing="4" alignment="BOTTOM_LEFT">
                            <Label text="" styleClass="label-soft"/>
                            <Button text="+ Add Category" styleClass="button, button-primary" prefHeight="36" onAction="#handleAddType"/>
                        </VBox>
                    </HBox>
                </VBox>

                <ListView fx:id="typeList" minHeight="450"/>
            </VBox>

            <!-- System Settings Tab Box -->
            <VBox fx:id="settingsBox" spacing="16" managed="false" visible="false">
                <ListView fx:id="settingList" minHeight="500"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
