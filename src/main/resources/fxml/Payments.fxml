<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.syntropyhq.aqarat.controller.PaymentsController"
            fitToWidth="true" hbarPolicy="NEVER">
    <VBox spacing="20">
        <padding>
            <Insets top="30" right="40" bottom="34" left="40"/>
        </padding>

        <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

        <VBox fx:id="contentBox" spacing="18">
            <!-- Header -->
            <VBox spacing="5">
                <Label text="COLLECTIONS" styleClass="eyebrow"/>
                <Label text="Money owed and received" styleClass="display-title"/>
                <Label text="A client declares a payment with proof; an agent confirms it. Nothing counts towards a contract until it has been confirmed." styleClass="hint" wrapText="true" maxWidth="760"/>
            </VBox>

            <!-- Segmented Tab Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="awaitingTabButton" text="Awaiting confirmation" styleClass="tab-pill-button, active"
                        onAction="#handleAwaitingTab"/>
                <Button fx:id="recordTabButton" text="Record a payment" styleClass="tab-pill-button"
                        onAction="#handleRecordTab"/>
            </HBox>

            <!-- Awaiting Confirmations Tab -->
            <VBox fx:id="awaitingBox" spacing="14">
                <ListView fx:id="declaredList" styleClass="page-list"/>
            </VBox>

            <!-- Record Contract Payment Tab -->
            <VBox fx:id="recordBox" spacing="16" managed="false" visible="false">
                <VBox styleClass="card" spacing="12">
                    <Label text="Contract Lookup" styleClass="section-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="contractIdField" promptText="Enter Contract ID (e.g. 201)" HBox.hgrow="ALWAYS"/>
                        <Button text="Lookup Schedule" styleClass="button, button-primary" onAction="#handleLoadContract"/>
                    </HBox>
                    <Label fx:id="contractSummaryLabel" styleClass="label-soft" style="-fx-font-weight: 600; -fx-text-fill: -c-primary;"/>
                    <Label fx:id="contractError" styleClass="field-error" managed="false" visible="false"/>
                </VBox>

                <VBox styleClass="card" spacing="12">
                    <Label text="Installment Payment Schedule" styleClass="section-title"/>
                    <ListView fx:id="scheduleList" minHeight="360"/>
                </VBox>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
