<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.syntropyhq.aqarat.controller.PaymentsController"
      styleClass="content" spacing="24">
    <Label text="Payments" styleClass="page-title"/>
    <Label fx:id="accessDeniedLabel" styleClass="empty-state" managed="false" visible="false"/>

    <VBox fx:id="contentBox" spacing="16" VBox.vgrow="ALWAYS">
        <HBox spacing="12">
            <Button fx:id="awaitingTabButton" text="Awaiting confirmation"
                    styleClass="button, button-primary" onAction="#handleAwaitingTab"/>
            <Button fx:id="recordTabButton" text="Record payment"
                    styleClass="button, button-secondary" onAction="#handleRecordTab"/>
        </HBox>

        <VBox fx:id="awaitingBox" spacing="16" VBox.vgrow="ALWAYS">
            <ListView fx:id="declaredList" VBox.vgrow="ALWAYS"/>
        </VBox>

        <VBox fx:id="recordBox" spacing="16" VBox.vgrow="ALWAYS">
            <VBox styleClass="card" spacing="12">
                <Label text="Find a contract" styleClass="section-title"/>
                <VBox spacing="4">
                    <Label text="Contract id" styleClass="label-soft"/>
                    <HBox spacing="8">
                        <TextField fx:id="contractIdField" HBox.hgrow="ALWAYS"/>
                        <Button text="Load contract" styleClass="button, button-secondary"
                                onAction="#handleLoadContract"/>
                    </HBox>
                    <Label fx:id="contractError" styleClass="field-error" managed="false" visible="false"/>
                    <Label fx:id="contractSummaryLabel" styleClass="hint" wrapText="true"/>
                </VBox>
            </VBox>

            <ListView fx:id="scheduleList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </VBox>
</VBox>
